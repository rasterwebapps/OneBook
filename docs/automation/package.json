{
  "name": "onebook-doc-automation",
  "version": "1.0.0",
  "description": "OneBook documentation automation scripts",
  "scripts": {
    "generate-brd": "node generate-brd.js",
    "generate-frd": "node generate-frd.js",
    "generate-trd": "node generate-trd.js",
    "generate-rtm": "node generate-rtm.js",
    "update-index": "node update-requirements-index.js",
